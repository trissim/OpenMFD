from make_device import *
#pair of device for 12 well plate
#make pair of device to fit in one 12 well plate well
base_path="./designs/open_chamber/2compartment/"
well_gap=4.5
well_rad=6.94/2.0
chan_l=(well_gap-well_rad)*2.0
chan_gap=0.03
chan_w=0.01
num_chans=int(well_rad/(chan_gap+chan_w))
num_connected_wells=4
add_wells=True
add_chambers=True
add_channels=True
#dimensions of each cut-out device
dims = [9*2, 9, 0]
#number of devices
grid_size = [6,8]
units_from_center=(1,1)

def save_model(model,base_path,base_name):
    dxf_path=osp.join(base_path,base_name+".scad")
    solid.scad_render_to_file(model,osp.join(dxf_path))
    to_dxf(dxf_path)

"""
MAKE SINGLE DEVICE
"""
#make bottom layer
(single_chamber_wells,_),_,(open_chamber,_)= make_open_chamber(wells_pos=wells_pos_from_center_2(well_gap),
                                        well_rad=well_rad,chan_l=chan_l,chan_w=chan_w,chan_gap=chan_gap,num_chans=num_chans,
                                        rows=1,columns=1,casing_x=dims[0],casing_y=dims[1],chamber_len_until=chan_l,
                                        rotate_units=0,add_channels=add_channels,add_wells=add_wells,
                                        add_chambers=add_chambers,alignment=None)
save_model(open_chamber,base_path,"2compartment_single_device_bottom")
save_model(single_chamber_wells,base_path,"2compartment_single_device_top")

"""
MAKE 96WELL DEVICE
"""

(chamber_wells_multi,_),_,(open_chamber_multi,_)= make_open_chamber(wells_pos=wells_pos_from_center_2(well_gap),
                                        well_rad=well_rad,chan_l=chan_l,chan_w=chan_w,chan_gap=chan_gap,num_chans=num_chans,
                                        rows=grid_size[0],columns=grid_size[1],casing_x=dims[0],casing_y=dims[1],chamber_len_until=chan_l,
                                        rotate_units=0,add_channels=add_channels,add_wells=add_wells,
                                        add_chambers=add_chambers,alignment=True,units_from_center=units_from_center)

save_model(open_chamber_multi,base_path,"2compartment_multi_device_bottom")
save_model(chamber_wells_multi,base_path,"2compartment_multi_device_top")

