												translate(v = [0, 0]) {
													square(center = true, size = [2.0600000000, 0.0100000000]);
												}
											}
											translate(v = [0, -1.7200000000]) {
												translate(v = [0, 0]) {
													square(center = true, size = [2.0600000000, 0.0100000000]);
												}
											}
										}
										union() {
											translate(v = [1.5450000000, 0]) {
												square(center = true, size = [1.0300000000, 3.4500000000]);
											}
											translate(v = [-1.5450000000, 0]) {
												square(center = true, size = [1.0300000000, 3.4500000000]);
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
