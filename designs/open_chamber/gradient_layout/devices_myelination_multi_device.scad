														square(center = true, size = [2.8900000000, 0.0100000000]);
													}
												}
											}
											union() {
												translate(v = [3.6125000000, 0]) {
													square(center = true, size = [4.3350000000, 3.4500000000]);
												}
												translate(v = [-3.6125000000, 0]) {
