"""
2-Compartment 96-Well Device - Pure OpenMFD Implementation

This version uses ONLY the openmfd package with NO legacy imports.
All functionality (wafer masks, alignment marks, centering, text) is
provided by the refactored openmfd modules.

Original: 2_compartment_96_well_v27_300um_suex200.py
Version: 27 (Pure OpenMFD)
SU-8 Height: 200μm
Grid: 6x8 (48 devices total)
"""

from pathlib import Path
import solid

# OpenMFD imports - ALL functionality from openmfd package
from openmfd.geometry import (
    wells_pos_from_center_2,
    wells_top_bottom,
    make_chambers,
    make_channels,
    make_well,
)
from openmfd.devices import (
    create_device_array,
    create_wafer_walls,
    create_glass_outline,
    create_wafer_mask,
    create_cure_temperature_text,
)
from openmfd.devices.wafer import compute_wafer_center
from openmfd.export import export_scad

# ViewSCAD for STL rendering
import viewscad
r = viewscad.Renderer()

# ============================================================================
# Configuration Parameters
# ============================================================================

VERSION = 27
BASE_PATH = Path(f"./designs/open_chamber/2_compartment_96_well_300um_suex200_v{VERSION}/")
DEVICE_NAME = f"2_compartment_96_well_300um_suex200_v{VERSION}"

# Device geometry
WELLS_POS = 4.5
WELL_RAD = 5.0 / 2.0
CHAN_GAP = 0.03
CHAN_W = 0.01
CHAN_L = 0.3
CHAN_L_EXTRA = 6.0
NUM_CHANS = int(WELL_RAD / (CHAN_GAP + CHAN_W))

# Chamber parameters
CHAMBER_LEN_UNTIL = WELLS_POS
CHAMBER_WIDTH = WELL_RAD * 2

# Casing dimensions
CASING_X, CASING_Y = 9 * 2, 9

# Array parameters (6x8 = 48 devices)
GRID_SIZE = [6, 8]
DIMS = [CASING_X, CASING_Y, 0]
ALIGNMENT_OFFSET = [(DIMS[0] - CASING_X) / 2.0, (DIMS[1] - CASING_Y) / 2]
UNITS_FROM_CENTER = (7, 4.75)
ALIGNMENT_MARK_SIZE = 1

# Wafer parameters
WAFER_SIZE, WAFER_FLAT_LEN = 150, 57.5
OUTER_MASK_THICKNESS, WAFER_LINE_THICKNESS = 3, 0.3

# Wall parameters
WALL_HEIGHT, WALL_THICKNESS, WALL_PADX, WALL_PADY = 10, 7, 9, 9

# Outline parameters
GLASS_SIZE, GLASS_ERROR, OUTLINE_ALIGNMENT_THICKNESS = [110, 74], 4, 1

# PDMS curing
CURE_TEMP = 100

# Insert parameters
CHAMBER_HOLE_DIMS = (2, 2)
INSERT_PIN_OFFSET = -0.5

# ============================================================================
# Helper Functions
# ============================================================================

def scale_percent_pdms_heat_shrinkage(cure_temp):
    """Calculate PDMS shrinkage based on curing temperature."""
    return 1.0 - (cure_temp * 0.002)

def save_models(base_path, models_dict):
    """Save multiple models to SCAD files."""
    base_path = Path(base_path)
    base_path.mkdir(parents=True, exist_ok=True)
    for name, model in models_dict.items():
        scad_path = base_path / f"{name}.scad"
        solid.scad_render_to_file(model, str(scad_path))
        print(f"Saved: {scad_path}")

def create_channels(length, width=CHAN_W, height=0.2, num_chans=NUM_CHANS, spacing=CHAN_GAP):
    """Create channels with default parameters."""
    return make_channels(length=length, width=width, height=height, num_chans=num_chans, spacing=spacing, dxf=True)

def create_insert_holes(positions, dims=CHAMBER_HOLE_DIMS):
    """Create square insert holes at given positions."""
    return solid.union()(*[
        solid.translate([pos[0], pos[1], 0])(make_well(dims=dims, height=None, dxf=True, shape="square"))
        for pos in positions
    ])

# ============================================================================
# Main Script
# ============================================================================

def main():
    print(f"\n{'='*70}")
    print(f"2-COMPARTMENT 96-WELL DEVICE - PURE OPENMFD VERSION")
    print(f"{'='*70}")
    print(f"Version: {VERSION}")
    print(f"Grid: {GRID_SIZE[0]}x{GRID_SIZE[1]} = {GRID_SIZE[0] * GRID_SIZE[1]} devices")
    print(f"SU-8 Height: 200μm")
    print(f"PDMS Shrinkage: Cure at {CURE_TEMP}°C (scale: {scale_percent_pdms_heat_shrinkage(CURE_TEMP):.4f})")
    
    scale_percent = scale_percent_pdms_heat_shrinkage(CURE_TEMP)
    cure_text = f"Cure at {CURE_TEMP}°C"
    
    # ========================================================================
    # Step 1: Create Single Device Unit
    # ========================================================================
    
    print("\n=== Creating Single Device Unit ===")
    
    # Calculate well positions
    well_positions = wells_pos_from_center_2(WELLS_POS)
    
    # Create top layer (wells + chambers) with insert holes
    _, measurements = create_channels(CHAN_L)
    chamber_wells_single = solid.difference()(
        solid.union()(
            wells_top_bottom(radius=WELL_RAD, height=None, positions=well_positions, dxf=True, shape="circle"),
            make_chambers(msrs=measurements, height=0.2, width=CHAMBER_WIDTH, len_until=CHAMBER_LEN_UNTIL, dxf=True)
        ),
        create_insert_holes(wells_pos_from_center_2(WELLS_POS + INSERT_PIN_OFFSET))
    )
    
    # Create bottom layer (channels only)
    channels_single, _ = create_channels(CHAN_L + CHAN_L_EXTRA)
    
    # Save single units
    save_models(BASE_PATH, {
        f"{DEVICE_NAME}_single_bottom": channels_single,
        f"{DEVICE_NAME}_single_top": chamber_wells_single,
        f"{DEVICE_NAME}_single_aligned": solid.union()(chamber_wells_single, channels_single),
    })
    
    # ========================================================================
    # Step 2: Create Decorations (Walls, Outline, Text)
    # ========================================================================
    
    print("\n=== Creating Decorations ===")
    
    # 3D Walls (STL)
    _, _, wafer_walls = create_wafer_walls(
        WAFER_SIZE, WALL_THICKNESS, GRID_SIZE, DIMS,
        height=WALL_HEIGHT, segments=256, make_inner=False,
        padx=WALL_PADX, pady=WALL_PADY
    )
    r.render(wafer_walls, outfile=str(BASE_PATH / f"wall_single_{DEVICE_NAME}.stl"))
    
    # Glass slide outline with alignment groove
    outline = create_glass_outline(
        [g - GLASS_ERROR for g in GLASS_SIZE], WALL_THICKNESS,
        GRID_SIZE, DIMS, ALIGNMENT_OFFSET, OUTLINE_ALIGNMENT_THICKNESS
    )
    
    # Cure temperature text
    text = create_cure_temperature_text(
        CURE_TEMP, GRID_SIZE, DIMS, size=2.0,
        include_instructions=True, alignment_offset=ALIGNMENT_OFFSET
    )
    
    # ========================================================================
    # Step 3: Create Arrays, Add Decorations, Scale, Add Wafer Masks, Export
    # ========================================================================

    print("\n=== Creating Arrays & Exporting ===")

    # Create arrays with alignment marks (using pure openmfd)
    # NOTE: Do NOT add outline to single device - it will be replicated 48 times!
    # We'll add ONE outline to the entire array after it's created.
    arrays = {
        'bottom': create_device_array(
            channels_single, DIMS, GRID_SIZE, dxf=True, alignment="full",
            units_from_center=UNITS_FROM_CENTER, alignment_offset=ALIGNMENT_OFFSET,
            alignment_mark_size=ALIGNMENT_MARK_SIZE
        ),
        'top': create_device_array(
            chamber_wells_single, DIMS, GRID_SIZE, dxf=True, alignment="hollow",
            units_from_center=UNITS_FROM_CENTER, alignment_offset=ALIGNMENT_OFFSET,
            alignment_mark_size=ALIGNMENT_MARK_SIZE
        ),
    }

    # Add decorations to arrays (outline and text are already centered at wafer center)
    # Add outline to top layer AFTER array creation (preserves difference() for alignment marks)
    arrays['top'] = solid.union()(arrays['top'], outline)
    arrays['bottom'] = solid.union()(arrays['bottom'], text)
    arrays['aligned'] = solid.union()(arrays['top'], arrays['bottom'])

    # Apply PDMS shrinkage scaling
    arrays = {name: solid.scale([scale_percent, scale_percent])(arr) for name, arr in arrays.items()} if scale_percent != 1.0 else arrays
    
    # Add wafer masks and export (using pure openmfd)
    save_models(BASE_PATH, {
        f"{DEVICE_NAME}_{name}": create_wafer_mask(
            WAFER_SIZE, WAFER_FLAT_LEN, geom, GRID_SIZE, DIMS,
            wafer_line_thickness=WAFER_LINE_THICKNESS,
            outer_mask_thickness=OUTER_MASK_THICKNESS,
            alignment_offset=ALIGNMENT_OFFSET,
            shrinkage_scale=scale_percent
        )
        for name, geom in arrays.items()
    })
    
    # ========================================================================
    # Summary
    # ========================================================================
    
    print(f"\n{'='*70}")
    print("EXPORT SUMMARY")
    print(f"{'='*70}")
    print(f"Output directory: {BASE_PATH}")
    print(f"Device name: {DEVICE_NAME}")
    print(f"Grid size: {GRID_SIZE[0]}x{GRID_SIZE[1]} ({GRID_SIZE[0] * GRID_SIZE[1]} devices)")
    print(f"Wells: 2 @ {WELL_RAD * 2}mm diameter")
    print(f"Channels: {NUM_CHANS} @ {CHAN_W}mm width")
    print(f"SU-8 height: 0.2mm (200μm)")
    print(f"PDMS scale: {scale_percent:.4f}")
    print(f"Cure temperature: {CURE_TEMP}°C")
    print(f"\n{'-'*70}")
    print("FILES GENERATED:")
    print(f"{'-'*70}\n")
    print("📄 Single Device Unit (for testing):")
    print(f"  ✅ {DEVICE_NAME}_single_bottom.scad (channels only)")
    print(f"  ✅ {DEVICE_NAME}_single_top.scad (wells + chambers)")
    print(f"  ✅ {DEVICE_NAME}_single_aligned.scad (both layers)")
    print(f"\n📐 3D Walls (for PDMS molding):")
    print(f"  ✅ wall_single_{DEVICE_NAME}.stl")
    print(f"\n🔲 Device Arrays ({GRID_SIZE[0]}x{GRID_SIZE[1]} = {GRID_SIZE[0] * GRID_SIZE[1]} devices):")
    print(f"  ✅ {DEVICE_NAME}_bottom.scad (channels + alignment marks + text)")
    print(f"  ✅ {DEVICE_NAME}_top.scad (wells + chambers + outline)")
    print(f"  ✅ {DEVICE_NAME}_aligned.scad (both layers + all features)")
    print(f"\n{'-'*70}")
    print("✅ ALL FUNCTIONALITY PROVIDED BY OPENMFD PACKAGE")
    print("✅ NO LEGACY IMPORTS FROM make_device.py")
    print(f"{'='*70}\n")

if __name__ == "__main__":
    main()

 
 
