from make_device import *
#pair of device for 12 well plate
#make pair of device to fit in one 12 well plate well
base_path="./designs/open_chamber/myelination/"
base_name="myelination_single_device"
well_gap=6.36
well_rad=6.94/2.0
chan_l=(well_gap-well_rad)*2.0
chan_gap=0.01
chan_w=0.01
num_chans=int(well_rad/(chan_gap+chan_w))
oligo_channel_width=0.1
_,_,(open_chamber,_)= make_open_chamber(wells_pos=wells_pos_from_center_2(well_gap),
                                        well_rad=well_rad,chan_l=chan_l/2,chan_w=chan_w,chan_gap=chan_gap,num_chans=num_chans,
                                        rows=1,columns=1,casing_x=0,casing_y=0,chamber_len_until=chan_l,
                                        rotate_units=0,alignment=None)

_,_,(oligo_chamber,_)= make_open_chamber(wells_pos=wells_pos_from_center_2(well_gap),
                                        well_rad=well_rad,chan_l=0,chan_w=oligo_channel_width,chan_gap=oligo_channel_width/2,num_chans=1,
                                        rows=1,columns=1,casing_x=0,casing_y=0,chamber_len_until=chan_l,
                                        rotate_units=0,alignment=None)


oligo_chamber=solid.rotate([0,0,90])(oligo_chamber)
connected_chambers=solid.union()(oligo_chamber,open_chamber)
